{
  "flow":"video-reference-inspired-ad-v1",
  "canonical":true,
  "default_intent":"inspired_not_copied",
  "copy_flow_only_when_explicit":true,
  "reference_use":{
    "learn":["hook","sales_structure","pacing","visual_grammar","motion_grammar","audio_grammar","cta_pattern"],
    "replace":["script","voice","text","brand","ui","assets","icons","composition_details"],
    "reuse_source_visual_frames":false
  },
  "video":{
    "default_width":720,
    "default_height":1280,
    "default_fps":30,
    "motion":"layer_based",
    "global_zoom_default":false,
    "crop_important_corners":false,
    "safe_frame_required":true,
    "preferred_effects":["slide","fade","mask_reveal","object_scale_subtle","parallax","glow_pulse","cursor_motion","click_ripple","chart_draw","ui_state_transition"]
  },
  "icons":{
    "preferred":["inline_svg","vector_paths","geometric_primitives","icon_library_to_svg"],
    "unverified_emoji_unicode_forbidden":true,
    "font_glyph_preflight":true,
    "visual_tofu_check":true,
    "square_box_icon_is_failure":true
  },
  "voice":{
    "language":"vi-VN",
    "preferred_voice":"vi-VN-NamMinhNeural",
    "scene_timed":true,
    "rate_percent_range":[-3,0],
    "pitch_hz_default":-1,
    "breathing_room_seconds":[0.2,0.45],
    "voice_lufs":-16
  },
  "music":{
    "acquisition":"DSH_audio_only",
    "default_genre":"light_ambient_tech_corporate_electronic",
    "instrumental_preferred":true,
    "perceived_level_percent":[8,10],
    "sidechain_ducking":true,
    "fade_in_seconds":[1.0,1.5],
    "fade_out_seconds":[2.0,3.0]
  },
  "final_mix":{
    "target_lufs":-14,
    "true_peak_db":-1.2
  },
  "visual_lock":{
    "audio_only_change_does_not_rerender_visuals":true,
    "video_stream_copy_when_possible":true,
    "verify_video_hash_before_after":true
  },
  "qa_required":["visual","audio","technical"],
  "known_good_baseline":"ProxyGrid layered V2 + NamMinh Neural + DSH ambient-tech, 2026-08-24",
  "known_bad_patterns":["single_poster_zoom","global_zoom_crop","source_frame_reuse_in_inspired_mode","rushed_tts","music_masking_voice","unicode_icon_to_square_box"]
}
