      "name": "VOZ",
      "discovery_urls": [
        "https://voz.vn/whats-new/",
        "https://voz.vn/"
      ],
      "thread_regex": "^/t/[^?#]+\\.\\d+(?:/page-\\d+)?/?$"
    },
    {
      "name": "Otofun",
      "discovery_urls": [
        "https://www.otofun.net/whats-new/",
        "https://www.otofun.net/"
      ],
      "thread_regex": "^/threads/[^?#]+\\.\\d+(?:/page-\\d+)?/?$"
    },
    {
      "name": "GameVN",
      "discovery_urls": [
        "https://forum.gamevn.com/whats-new/posts/",
        "https://forum.gamevn.com/"
      ],
      "thread_regex": "^/threads/[^?#]+\\.\\d+(?:/page-\\d+)?/?$"
    },
    {
      "name": "Tinhte",
      "discovery_urls": [
        "https://tinhte.vn/"
      ],
