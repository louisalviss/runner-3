{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "runner3-audio-library",
  "main": "auth-wrapper.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "LIBRARY_ACCESS_SHA256": "5d494ffec5f90953e09fa5dd32b968e83238fa5b15434c86d7b9d6f420f083eb",
    "DEFAULT_RETENTION_DAYS": "30"
  },
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "runner3-wp-media"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
