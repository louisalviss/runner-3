{
  "schema_version": 2,
  "updated_at": "2026-09-17T06:55:00+07:00",
  "status": "active",
  "scope": "rss-render-personalization",
  "mode": "recall-first",
  "goal": "Reduce low-interest RSS clutter without missing articles the user would have wanted to deep-read.",
  "canonical_invariants": {
    "canonical_manifest_remains_complete": true,
    "canonical_numbering_remains_immutable": true,
    "personalization_must_not_hard_delete_items": true,
    "personalization_must_not_change_ingestion_or_dedupe_accounting": true
  },
  "default_render_policy": {
    "primary_personalized_target": 26,
    "exploration_target_min": 8,
    "exploration_target_max": 12,
    "visible_target_range": [34, 38],
    "remaining_items": "collapsed_not_deleted",
    "show_full_manifest_on_request": true,
    "priority": "recall_over_precision"
  },
  "exploration_policy": {
    "purpose": "Protect against filter bubbles and unseen-interest false negatives.",
    "include_items_with_novel_or_unseen_interest_families": true,
    "do_not_treat_unmatched_profile_as_dislike": true,
    "prefer_novelty_when_relevance_confidence_is_low": true,
    "boost_exploration_families": [
      "social_mechanisms_and_demographic_behavior",
      "science_or_medical_oddities_with_explanatory_value",
      "vietnam_institutions_and_generation_change",
      "ai_culture_language_and_human_authorship",
      "macro_policy_and_data_quality_mechanisms",
      "automation_labor_and_symbolic_adoption_signals",
      "china_vietnam_soft_power_and_structural_relations"
    ],
    "retain_penalty_families": [
      "routine_gadget_specs",
      "shopping_only",
      "celebrity_filler",
      "generic_lifestyle",
      "duplicated_event_coverage"
    ]
  },
  "signal_semantics": {
    "deep_read": "medium_positive_interest_signal_not_equivalent_to_like",
    "selected": "attention_signal_not_equivalent_to_like",
    "liked": "strong_positive_signal",
    "disliked": "strong_negative_signal",
    "non_selection": "no_negative_inference"
  },
  "negative_signal_policy": {
    "explicit_dislike_required_for_strong_negative": true,
    "low_score_alone_must_not_hide": true,
    "collapse_aggressively_only_when": [
      "low_personal_relevance_score",
      "matches_repeated_negative_interest_family",
      "negative_confidence_is_high"
    ],
    "single_day_dislike_guard": "Do not hard-exclude an entire interest family from one disliked article; accumulate repeated evidence across days."
  },
  "miss_detection": {
    "track_selected_or_deep_read_items_from_collapsed_section": true,
    "if_collapsed_items_are_selected_repeatedly": "reduce_filtering_and_expand_exploration",
    "key_metrics": [
      "recall_at_k",
      "precision_at_k",
      "ndcg_at_k",
      "collapsed_section_miss_rate"
    ],
