{
  "schema_version": 2,
  "standard": "docs/FLOW_STORAGE_STANDARD.md",
  "control_center": {
    "kind": "google_sheet",
    "title": "AI Flow Control Center",
    "spreadsheet_id": "1w04Z0HavtB36DwsSgKhEtNGJS4wauNCEyjQCY4pXc_A",
    "sheet": "Flows"
  },
  "shared_r2": {
    "default_bucket": "runner3-artifacts"
  },
  "flows": [
    {
      "flow_id": "ebook-auto",
      "pattern": "full",
      "entrypoint": "louisalviss/vps-control:stack/ebook_auto.py",
      "workflow": "louisalviss/vps-control:.github/workflows/ebook-codex-job.yml",
      "ingress": {
        "default_for_chatgpt_file_uploads": [
          "application/pdf",
          "application/epub+zip",
          ".pdf",
          ".epub"
        ],
        "accepted": [
          "chatgpt-library-file",
          "r2",
          "public-https-url"
        ],
        "explicit_intent_override": [
          "translate",
          "editorial",
          "qa-only",
          "repair"
        ],
        "auto_when_intent_missing": true
      },
      "routing": {
        "pdf": "pdf-extract-or-ocr -> reconstructed-epub -> auto-classify",
        "foreign_epub": "bookforge-canonical-literary",
        "vietnamese_needs_edit": "ebook-editorial",
        "vietnamese_good": "qa-only",
        "repair": "repair -> unified-final-qa",
        "final_gate": "unified-final-file-qa"
      },
      "specialists": {
        "translation": "bookforge+codex canonical-literary-v1",
        "editorial": "ebook-editorial resumable chapters",
        "pdf": "ocr-pdf/MinerU extraction plus EPUB reconstruction",
        "legacy_translation": "ebook_runtime.py compatibility only",
        "web_novel": "AI-WEB-NOVEL-EPUB-001 when source is a web-novel URL rather than an uploaded file"
      },
      "d1": {
        "project": "ebook",
        "scope": "<book_id_or_job_id>"
      },
      "r2": {
        "bucket": "runner3-artifacts",
        "prefix": "core/ebook/<book_id_or_job_id>",
        "layout": [
          "source/",
          "work/",
          "control/",
          "qa/",
          "final/"
        ]
      },
      "delivery": {
        "final": "R2 final/<visible-version>.epub",
        "readback_sha256_required": true,
        "signed_delivery_link": true,
        "max_ttl_seconds": 3600
      },
      "sheet": {
        "mode": "projection",
        "row_key": "ebook-auto"
      },
      "dropbox": {
        "mode": "canonical-docs-and-optional-human-final-only"
      },
      "legacy_aliases": [
        "ebook-editorial",
        "ebook-translate",
        "ebook-bookforge",
        "pdf-to-epub",
        "epub-repair"
      ],
      "completion": [
        "FINAL_FILE_QA_PASS",
        "FINAL_BYTES_FROZEN",
        "DURABLE_COMPLETE",
        "SIGNED_URL_READY"
      ]
    },
    {
      "flow_id": "audio-library-tts",
      "pattern": "full",
      "d1": {
        "project": "audio-library-tts",
        "scope": "<item_id>"
      },
      "r2": {
        "bucket": "runner3-wp-media",
        "prefix": "audio-library"
      },
      "sheet": {
        "mode": "projection"
      },
      "dropbox": {
        "mode": "optional-human-output"
      }
    },
    {
      "flow_id": "reddit-deep-sweep",
      "pattern": "archive",
      "d1": {
        "mode": "none",
        "hard_rule": "RealDayTrading corpus must not use D1"
      },
      "r2": {
        "bucket": "runner3-artifacts",
        "prefix": "reddit/RealDayTrading",
        "role": "canonical",
        "layout": {
          "raw_runs": "reddit/RealDayTrading/runs/",
          "corpus_snapshots": "reddit/RealDayTrading/corpus/snapshots/",
          "latest_pointer": "reddit/RealDayTrading/corpus/latest.json"
        }
      },
      "sheet": {
        "mode": "projection"
      },
      "dropbox": {
        "mode": "flow-docs-only"
      },
      "scope": {
        "canonical_subreddit": "RealDayTrading",
        "purpose": "RealDayTrading trading-strategy research corpus",
        "allow_cross_subreddit_threads_only_when_linked_from_realdytrading_corpus": true,
        "not_for": [
          "user-supplied Reddit URLs",
          "generic Reddit browsing/reading",
          "Reddit MMO Scan",
          "other subreddit crawls"
        ]
      },
      "local_query": {
        "format": "SQLite + JSONL",
        "role": "working/query index",
        "full_comments": true
      },
      "telegram": {
        "target": "Trading Research Library",
        "chat_id": "-1003986555024",
        "role": "backup/delivery"
      }
    },
    {
      "flow_id": "reddit-read",
      "pattern": "lean",
      "scope": "one current/user-supplied Reddit URL",
      "entrypoint": "scripts/reddit_read.py",
      "routing": "reddit_common.read_current_thread",
      "d1": {
        "mode": "none",
        "hard_rule": "must not write reddit-deep-sweep tables"
      },
      "r2": {
        "mode": "parent-owned-optional",
        "hard_rule": "must not join the RealDayTrading corpus unless explicitly invoked by that corpus flow"
      },
      "sheet": {
        "mode": "none"
      },
      "dropbox": {
        "mode": "none"
      },
      "notes": "Canonical generic Reddit link reader. Separate from reddit-deep-sweep."
    },
    {
      "flow_id": "rss-reader",
      "pattern": "lean",
      "d1": {
        "project": "rss-reader",
        "role": "operational-shadow-checkpoint"
      },
      "r2": {
        "mode": "not-required-by-default"
      },
      "sheet": {
        "mode": "optional-projection"
      },
      "dropbox": {
        "mode": "optional-report"
      }
    },
    {
      "flow_id": "vietnam-news-radar",
      "pattern": "lean",
      "d1": {
        "project": "vietnam-news-radar",
        "role": "bounded-story-and-f33-ledger"
      },
      "r2": {
        "mode": "only-for-large-raw-archives"
      },
      "sheet": {
        "mode": "optional-projection"
      },
      "dropbox": {
        "mode": "human-report"
      }
    },
    {
      "flow_id": "business-opportunity-research-ledger",
      "pattern": "lean",
      "d1": {
        "project": "runner3-business-opportunity",
        "binding": "BUSINESS_OPPORTUNITY_DB",
        "role": "cross-source-candidate-identity-evidence-state"
      },
      "r2": {
        "mode": "not-required-by-default"
      },
      "sheet": {
        "mode": "optional-projection"
      },
      "dropbox": {
        "mode": "human-canonical-project-docs",
        "portfolio_authority": "AI-MEMORY/PROJECTS/Projects Map.md"
      },
      "notes": "Machine SOT for cross-source research identity/evidence state only; never merge with Finance/Trading Opportunity Radar V2."
    },
    {
      "flow_id": "opportunity-radar-v2",
      "pattern": "special",
      "d1": {
        "project": "opportunity-radar-v2",
        "role": "runtime-checkpoint"
      },
      "r2": {
        "mode": "only-for-large-artifacts"
      },
      "sheet": {
        "mode": "decision-layer-plus-projection",
        "human_decisions_authoritative": true
      },
      "dropbox": {
        "mode": "docs-archive"
      }
    },
    {
      "flow_id": "wordpress-optimizer",
      "pattern": "lean",
      "d1": {
        "role": "site-run-machine-state"
      },
      "r2": {
        "mode": "use-for-large-proof-artifacts"
      },
      "sheet": {
        "mode": "projection"
      },
      "dropbox": {
        "mode": "human-report-final"
      }
    }
  ]
}
