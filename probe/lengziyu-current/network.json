ements.copied\":\"{label} copied\",\"uCardRequirements.verification.verified\":\"Verified\",\"uCardRequirements.verification.needsReview\":\"Needs review\",\"uCardRequirements.verification.unverified\":\"Unverified\",\"uCardRequirements.note\":\"Note\",\"uCardRequirements.pending\":\"Pending\",\"uCardRequirements.pendingSummary\":\"Requirements pending\",\"uCardRequirements.viewCardDetail\":\"View {name} card details\",\"uCardRequirements.toggleDetails\":\"Show or hide source details\",\"uCardRequirements.noticeTitle\":\"Important\",\"uCardRequirements.noticeCopy\":\"Requirements may change. Overseas proof often includes address evidence, bank statements, or local residence documents. Follow the platform's latest rules.\",\"uCardRequirements.loadFailed\":\"Requirements are unavailable\",\"uCardRequirements.retry\":\"Try again\",\"uCardRequirements.emptyTitle\":\"No matching cards\",\"uCardRequirements.emptyCopy\":\"Try another filter.\",\"profileLanguage.title\":\"Language\",\"profileLanguage.current\":\"Current language\",\"profileHelp.title\":\"Help\",\"profileApp.title\":\"CardFi App\",\"profileApp.eyebrow\":\"Coming soon\",\"profileApp.banner.kicker\":\"CardFi App · Coming soon\",\"profileApp.banner.title\":\"The App is on its way\",\"profileApp.banner.copy\":\"More features. A better experience.\",\"profileApp.banner.action\":\"Explore\",\"profileApp.heroTitle\":\"The App is on its way, built around every card you follow.\",\"profileApp.heroCopy\":\"From a quick card lookup to ongoing organization, comparison, and follow-up, CardFi App turns scattered public information into a clearer mobile experience.\",\"profileApp.heroPoints.wallet\":\"Organize your wallet and saves together\",\"profileApp.heroPoints.compare\":\"Compare cards with clearer differences\",\"profileApp.heroPoints.focus\":\"Redesigned for mobile\",\"profileApp.previewTitle\":\"A first look at the App\",\"profileApp.previewCopy\":\"Card details, market discovery, multi-card comparison, card effects, and Pro features are being redesigned for a more immersive mobile experience. Tap an image to enlarge it.\",\"profileApp.screenshots.comparison.title\":\"Focused card comparison\",\"profileApp.screenshots.comparison.copy\":\"Compare 2–4 cards at once and see the differences clearly.\",\"profileApp.screenshots.market.title\":\"Explore global accounts\",\"profileApp.screenshots.market.copy\":\"Filter card and account capabilities to find options worth exploring.\",\"profileApp.screenshots.detail.title\":\"Immersive card details\",\"profileApp.screenshots.detail.copy\":\"Browse fees, regions, KYC, and benefits together.\",\"profileApp.screenshots.effects.title\":\"Switch card effects freely\",\"profileApp.screenshots.effects.copy\":\"Preview particles, flames, fireworks, and other card effects, then switch or turn them off in one tap.\",\"profileApp.screenshots.pro.title\":\"Explore Pro features\",\"profileApp.screenshots.pro.copy\":\"See AI card matching, AI application guidance, multi-card comparison, long-term data, and other Pro capabilities together.\",\"profileApp.aiTitle\":\"AI turns information into better preparation\",\"profileApp.aiCopy\":\"It does not decide for you. It organizes public information, your stated preferences, and open questions so you can judge the next step yourself.\",\"profileApp.ai.match.title\":\"AI card matching\",\"profileApp.ai.match.copy\":\"See which cards you may be eligible to apply for and which ones fit your needs.\",\"profileApp.ai.prepare.title\":\"AI application guidance\",\"profileApp.ai.prepare.copy\":\"Walk through the application process and organize the documents and checks you need before applying.\",\"profileApp.ai.bill.title\":\"AI statement recognition\",\"profileApp.ai.bill.copy\":\"Upload one statement image to identify transactions, amounts, and fee information.\",\"profileApp.compareCopy\":\"The web is for quick public-information lookups. The long-term management, comparison, and AI capabilities below are available in the App. Tap the poster to enlarge it.\",\"profileApp.comparePoster.web\":\"Web\",\"profileApp.comparePoster.webTag\":\"Open and check · Lightweight\",\"profileApp.comparePoster.app\":\"CardFi App\",\"profileApp.comparePoster.appTag\":\"Manage over time · Go deeper\",\"profileApp.compareFeature.wallet\":\"Card wallet, saves, and workspace\",\"profileApp.compareFeature.compare\":\"Focused 2–4 card comparison and fee estimates\",\"profileApp.compareFeature.offline\":\"Selected public information available offline\",\"profileApp.compareFeature.follow\":\"Rule-change follows and reminders\",\"profileApp.compareFeature.assistant\":\"AI card matching and application guidance\",\"profileApp.compareFeature.bill\":\"AI statement recognition\",\"profileApp.comparePoster.webOne\":\"Quick public-information lookups\",\"profileApp.comparePoster.webTwo\":\"Search, filter, and view details\",\"profileApp.comparePoster.webThree\":\"Open anywhere for a quick check\",\"profileApp.comparePoster.webFour\":\"No install required for one-off checks\",\"profileApp.comparePoster.appOne\":\"A card wallet, saves, and workspace\",\"profileApp.comparePoster.appTwo\":\"Focused 2–4 card comparisons and fee estimates\",\"profileApp.comparePoster.appThree\":\"Offline public data, follows, and AI assistance\",\"profileApp.comparePoster.appFour\":\"Keep long-term records and manage cards continuously\",\"profileApp.comparePoster.action\":\"Tap to enlarge\",\"profileApp.closePreview\":\"Close preview\",\"profileApp.beta.title\":\"CardFi App\",\"profileApp.beta.closedNotice\":\"Coming soon. Stay tuned.\",\"profileApp.compareTitle\":\"Web vs. App\",\"profileApp.compareFeature\":\"Capability\",\"profileApp.compareWeb\":\"Web\",\"profileApp.compareApp\":\"CardFi App\",\"profileApp.rows.browse.feature\":\"Browse public card information\",\"profileApp.rows.browse.web\":\"Available\",\"profileApp.rows.browse.app\":\"Available, optimized for mobile\",\"profileApp.rows.compare.feature\":\"Multi-card comparison and fee scenarios\",\"profileApp.rows.compare.web\":\"Primarily single-card views\",\"profileApp.rows.compare.app\":\"Focused 2–4 card comparison and fee estimates\",\"profileApp.rows.workspace.feature\":\"Personal organization and workspace\",\"profileApp.rows.workspace.web\":\"Browsing and basic account sync\",\"profileApp.rows.workspace.app\":\"Manage card wallet, follows, and comparisons together\",\"profileApp.rows.offline.feature\":\"Offline public information\",\"profileApp.rows.offline.web\":\"Requires a connection\",\"profileApp.rows.offline.app\":\"Save selected public information to the device\",\"profileApp.rows.assistant.feature\":\"AI card matching and application guidance\",\"profileApp.rows.assistant.web\":\"Not available\",\"profileApp.rows.assistant.app\":\"Planned for Pro: check potential eligibility and walk through the application process\",\"profileApp.rows.follow.feature\":\"Rule-change follows\",\"profileApp.rows.follow.web\":\"Not available\",\"profileApp.rows.follow.app\":\"Manage follows; real-time alerts are still in preparation\",\"profileApp.rows.bill.feature\":\"AI statement recognition\",\"profileApp.rows.bill.web\":\"Not available\",\"profileApp.rows.bill.app\":\"Planned for Pro: identify transactions, amounts, and fees from an uploaded statement\",\"profileApp.planned\":\"Planned\",\"profileApp.note\":\"CardFi organizes public information only. It does not provide financial services, investment advice, or card-opening services. Fees, regional limits, KYC requirements, and application outcomes are always subject to the issuer’s latest official rules.\",\"profileAbout.title\":\"About\",\"help.q1\":\"How do I add a card?\",\"help.a1\":\"Open Add or any card detail page, then tap Add to My Cards.\",\"help.q2\":\"What do the ranking tiers mean?\",\"help.a2\":\"They are personal reference tiers, not official ratings.\",\"help.q3\":\"What can I do with cards on the home page?\",\"help.a3\":\"The home page supports a few gestures: long press a card and drag it up or down to reorder, tap the page title to hide the bottom navigation and tap again to restore it, and use a two-finger pinch on the card area to adjust card height.\",\"help.q4\":\"Are screenshot-generated drafts available now?\",\"help.a4\":\"There is no screenshot-to-draft entry in the regular user flow right now. If a card is missing or some info is wrong, please use Recommend Card or Suggest a Correction instead.\",\"help.q5\":\"Why is some card information still incomplete?\",\"help.a5\":\"Some card details are still being filled in, and fees, perks, region limits, or wallet support can change with official rules. We keep updating the data, but the official source should always be the final reference.\",\"about.s1.title\":\"What we are building\",\"about.s1.copy\":\"This product organizes common U cards, credit cards, debit cards, and bank accounts into a mobile-first card library that is easier to compare and track.\",\"about.s2.title\":\"Why we rank cards\",\"about.s2.copy\":\"Real card experience is more than official specs. The ranking makes experience, application threshold, perk density, and reliability easier to compare.\",\"about.s3.title\":\"Where the data comes from\",\"about.s3.copy\":\"Data currently comes from manual curation, public official sources, screenshot draft imports, and admin review. We keep sources when possible, but official rules should always win.\",\"about.contact.title\":\"Contact\",\"about.contact.copy\":\"Reach out for data feedback, product suggestions, or collaboration. The main channels are listed here.\",\"about.contact.email\":\"Email\",\"about.contact.x\":\"X\",\"about.contact.telegram\":\"Telegram\",\"about.contact.whatsapp\":\"WhatsApp\",\"about.contact.copyAction\":\"Copy\",\"about.contact.messageAction\":\"Leave a message\",\"about.contact.toastCopied\":\"{label} copied\",\"about.contact.toastCopyFailed\":\"Unable to copy right now. Please try again.\",\"about.policy.title\":\"Data policy\",\"about.policy.copy\":\"We do not change card data because of money, partnerships, or any other benefit exchange. Public sources, actual usage, and manual verification stay the standard.\",\"about.policy.privacy\":\"Privacy Policy\",\"about.policy.terms\":\"Terms of Service\",\"about.policy.deletion\":\"Account Deletion\",\"about.source.title\":\"Data sources & attribution\",\"about.source.before\":\"Data comes from manual curation, public official sources, screenshot drafts, and admin review; some card details, card-art references, and no-KYC information are compiled with reference to\",\"about.source.after\":\". We respect and credit TODEY’s public work; this project is not affiliated with or officially partnered with TODEY. Fees, rules, and availability should always be checked against the issuer’s latest official information.\",\"auth.login.title\":\"Welcome back\",\"auth.login.subtitle\":\"Log in to manage your cards and saves\",\"auth.login.error\":\"Login failed. Please try again.\",\"auth.login.empty\":\"Enter username / email and password\",\"auth.login.account\":\"Username / Email\",\"auth.login.password\":\"Password\",\"auth.login.remember\":\"Keep me signed in\",\"auth.login.submit\":\"Log in\",\"auth.login.loading\":\"Logging in...\",\"auth.login.create\":\"Create account\",\"auth.forgotPassword\":\"Forgot password?\",\"auth.divider\":\"or\",\"auth.register.title\":\"Create account\",\"auth.register.subtitle\":\"Save your cards and sync across pages\",\"auth.register.error\":\"Registration failed. Please try again.\",\"auth.register.empty\":\"Enter username / email and password\",\"auth.register.username\":\"Username / Email\",\"auth.register.email\":\"Username / Email\",\"auth.register.password\":\"Password\",\"auth.register.submit\":\"Create account\",\"auth.register.loading\":\"Creating account...\",\"auth.register.login\":\"Already have an account\",\"auth.showPassword\":\"Show password\",\"auth.hidePassword\":\"Hide password\",\"auth.placeho