[Unit]
Description=Wave Rider M30 frozen forward shadow validation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=github-runner
Group=github-runner
WorkingDirectory=/opt/wr-m30-forward
EnvironmentFile=/etc/vps-control/dropbox.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/wr-m30-forward/forward.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/wr-m30-forward

[Install]
WantedBy=multi-user.target
