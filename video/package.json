{
  "name": "runner3-remotion-video",
  "private": true,
  "scripts": {
    "render": "remotion render src/index.jsx PalmMotion out/remotion-smoke.mp4 --codec=h264 --crf=18",
    "render:motion:a": "remotion render src/motion-ab.jsx MotionA out/motion-a.mp4 --codec=h264 --crf=18 --concurrency=1",
    "render:motion:b": "remotion render src/motion-ab.jsx MotionB out/motion-b.mp4 --codec=h264 --crf=18 --concurrency=1 --gl=swangle",
    "render:motion:ab": "npm run render:motion:a && npm run render:motion:b",
    "render:motion:b2": "remotion render src/motion-ab.jsx MotionB2 out/motion-b2.mp4 --codec=h264 --crf=18 --concurrency=1 --gl=swangle",
    "render:wallet-flow": "remotion render src/wallet-flow.jsx WalletFlow out/wallet-flow.mp4 --codec=h264 --crf=18 --concurrency=1 --gl=swangle"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/gsap": "4.0.541",
    "@remotion/three": "4.0.541",
    "@react-three/fiber": "9.8.2",
    "gsap": "3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "three": "0.187.0"
  }
}
