# Required. Unpacked Writing Brain V2.3 index directory containing writing_brain.sqlite.
AINOVEL_WRITING_BRAIN_INDEX=/opt/writing-brain/webnovel-writing-brain-nli-v2-3-2026-08-20

# Required. Existing production runtime from louisalviss/runner-3.
AINOVEL_WRITING_BRAIN_SCRIPT=/opt/runner-3/scripts/webnovel_writing_brain_context_agent.py

# Optional.
AINOVEL_WRITING_BRAIN_PYTHON=python3
AINOVEL_WRITING_BRAIN_TIMEOUT_SECONDS=30
AINOVEL_WRITING_BRAIN_FAIL_OPEN=true

# Optional. Default when unset: <bookDir>/meta/writing_brain
# AINOVEL_WRITING_BRAIN_TRACE_DIR=/data/novel/meta/writing_brain

# Production pin (documentation/deployment verification; the Go tool also records this identity in traces).
WRITING_BRAIN_EXPECTED_RELEASE_TAG=webnovel-writing-brain-nli-v2-3-2026-08-20
WRITING_BRAIN_EXPECTED_ASSET_SHA256=f961aa5d4b924b4ef7201fb2d0f5b676fa7fd6579e0d70eedbe5669447fbc4db
