{
  "name": "runner3-core",
  "main": "rss-reader-read-fast-entry.js",
  "compatibility_date": "2026-08-22",
  "vars": {
    "RUNNER3_CORE_WRITE_AUTH": "required",
    "RSS_READER_PUBLIC_ORIGIN": "https://runner3-core.ducduy2411.workers.dev"
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "runner3-core",
      "database_id": "514a2c61-3f7a-44d0-a51b-e07525d32a5d"
    },
    {
      "binding": "OPPORTUNITY_DB",
      "database_name": "runner3-opportunity-radar",
      "database_id": "823fccf7-0d71-4849-b262-4974ffbc49f2"
    },
    {
      "binding": "LIBRARY_DB",
      "database_name": "personal-library",
      "database_id": "739f4891-7aa1-4381-a5f7-fff91d794609",
      "migrations_dir": "migrations-personal-library"
    },
    {
      "binding": "BUSINESS_OPPORTUNITY_DB",
      "database_name": "runner3-opportunity-radar",
      "database_id": "823fccf7-0d71-4849-b262-4974ffbc49f2"
    },
    {
      "binding": "TASK_CONTEXT_DB",
      "database_name": "louis-task-context",
      "database_id": "c38edfd8-fe68-4ff6-bfda-3ee2aac45352"
    },
    {
      "binding": "CONTEXT_INDEX_DB",
      "database_name": "louis-context-index",
      "database_id": "d89743b6-bddb-4255-9d25-1407c0a1049f"
    },
    {
      "binding": "CONTENT_DB",
      "database_name": "runner3-content-intelligence",
      "database_id": "9cbec4ec-c930-459d-9499-9c66166c9241"
    },
    {
      "binding": "RSS_DB",
      "database_name": "runner3-rss",
      "database_id": "ddc46c3b-c463-4f91-a298-0bc73152901f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "runner3-artifacts"
    },
    {
      "binding": "AUDIO_MEDIA",
      "bucket_name": "runner3-wp-media"
    }
  ],
  "services": [
    {
      "binding": "RSS_FASTLANE",
      "service": "runner3-rss-fastlane"
    }
  ]
}
