[Unit]
Description=Independent Acquisition daily evidence audit; fail on incomplete scan or Dropbox
Wants=network-online.target
After=network-online.target opportunity-daily.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/var/lib/acquisition-radar-scan
ExecStartPre=/usr/bin/python3 /var/lib/acquisition-radar-scan/audit_gap_ledger.py
ExecStart=/usr/bin/python3 /var/lib/acquisition-radar-scan/daily_acceptance.py
TimeoutStartSec=90s
