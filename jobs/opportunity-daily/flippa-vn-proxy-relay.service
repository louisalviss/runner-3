[Unit]
Description=Dedicated Flippa legacy Docker HTTP relay through verified VN VPN egress
After=docker.service vyprvpn-egress.service
Requires=docker.service
Wants=vyprvpn-egress.service
[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/flippa-vn-proxy-relay.py
Restart=always
RestartSec=3
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run
[Install]
WantedBy=multi-user.target
