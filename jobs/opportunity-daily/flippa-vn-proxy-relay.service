[Unit]
Description=Dedicated Flippa profile HTTP relay through FAST2 general egress
After=docker.service
Requires=docker.service
[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/flippa-vn-proxy-relay.py
Restart=always
RestartSec=3
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run
[Install]
WantedBy=multi-user.target
